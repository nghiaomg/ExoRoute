# Server
EXOROUTE_HOST=127.0.0.1
EXOROUTE_PORT=8686
# ExoRoute serves plain HTTP and only accepts loopback bind addresses.
# For remote access, use a TLS reverse proxy on this host that forwards over loopback.
# Local/private upstreams are blocked unless explicitly enabled.
EXOROUTE_ALLOW_PRIVATE_PROVIDER_URLS=false
# Enable only behind a loopback proxy that overwrites X-Forwarded-For/X-Forwarded-Proto and preserves Host.
EXOROUTE_TRUST_PROXY_HEADERS=false
# By default, the data directory and database are stored in ~/.exoroute
# (Windows: %USERPROFILE%\.exoroute). Uncomment these to override the paths.
# Relative paths are resolved from the .env file's directory.
# EXOROUTE_DATA_DIR=data
# EXOROUTE_DATABASE_PATH=data/exoroute.lmdb

# Leave empty on first run: ExoRoute generates a unique admin password and saves it here.
# Dashboard password changes are also stored in the database for backup/restore.
EXOROUTE_ADMIN_KEY=
# Automatically generated and saved here on the first server startup. Keep it stable;
# changing it makes saved provider credentials unreadable.
EXOROUTE_MASTER_KEY=

# Antigravity OAuth requires a Google OAuth client registered for this deployment.
# Public PKCE clients may leave the client secret empty.
# EXOROUTE_ANTIGRAVITY_OAUTH_CLIENT_ID=
# EXOROUTE_ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Upstream timeouts
CONNECT_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=300000
STREAM_IDLE_TIMEOUT_MS=120000

# Provider circuit breaker settings
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Operational defaults are used until the dashboard saves a database override.
# Reset from the dashboard reapplies these values read at process startup.
GATEWAY_MAX_IN_FLIGHT=64
UPSTREAM_RESPONSE_LIMIT_MIB=16
ADMIN_API_RATE_LIMIT_REQUESTS=300
ADMIN_API_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_KEY_RATE_LIMIT_CAPACITY=5000
GATEWAY_KEY_RATE_LIMIT_REFILL_TOKENS=1
GATEWAY_KEY_RATE_LIMIT_REFILL_INTERVAL_MS=1
REQUEST_LOG_RETENTION_DAYS=30
REQUEST_LOG_MAX_ROWS=100000
